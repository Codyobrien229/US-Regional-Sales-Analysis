      <aliases enabled='yes' />
      <column caption='Revenue' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;-&quot;$&quot;#,##0,,.00M' name='[Calculation_5128504267345920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Order Quantity] * [Unit Price] * (1 - [Discount Applied])' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_5128504267853825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5128504267345920] - ([Order Quantity] * [Unit Cost])' />
      </column>
      <column caption='Profit Margin' datatype='real' default-format='p0%' name='[Calculation_5128504267939842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5128504267853825]) / SUM([Calculation_5128504267345920])' />
      </column>
      <column caption='Average Order Value' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_5128504268316675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5128504267345920]) / COUNTD([OrderNumber])' />
      </column>
      <column caption='Delivery Days' datatype='integer' name='[Calculation_5128504268431364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [OrderDate], [DeliveryDate])' />
      </column>
